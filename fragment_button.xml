<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ButtonFragment">
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="30dp"
        android:columnCount="4">
        <Button android:id="@+id/btn1" android:text="1" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btn2" android:text="2" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btn3" android:text="3" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btnPlus" android:text="+" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btn4" android:text="4" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btn5" android:text="5" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btn6" android:text="6" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btn7" android:text="-" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btnSub" android:text="7" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btn8" android:text="8" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btn9" android:text="9" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btnMul" android:text="*" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btn0" android:text="0" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btnC" android:text="C" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btnequal" android:text="=" android:layout_height="70dp" android:textSize="40sp"/>
        <Button android:id="@+id/btnDiv" android:text="/" android:layout_height="70dp" android:textSize="40sp"/>

    </GridLayout>


</FrameLayout>